{% set customizationData = product.customFields.advanced_product_customization_options ?? [] %}
{% set steps = customizationData|length > 0 ? customizationData : [
    {
        id: 'engraving',
        title: 'Engraving',
        description: 'Choose your engraving style',
        options: [
            { id: 'engraving-script', label: 'Script engraving', price: 10, description: 'Elegant cursive style.' },
            { id: 'engraving-block', label: 'Block engraving', price: 5, description: 'Modern sans serif characters.' }
        ]
    },
    {
        id: 'packaging',
        title: 'Gift packaging',
        description: 'Select a packaging option',
        options: [
            { id: 'gift-basic', label: 'Basic wrapping', price: 3, description: 'Simple tissue wrap.' },
            { id: 'gift-premium', label: 'Premium box', price: 12, description: 'Rigid gift box with ribbon.' }
        ]
    }
] %}

{% if steps|length > 0 %}
    <div class="product-detail-customization" data-advanced-product-customization>
        <div class="product-detail-customization__header">
            <h3 class="product-detail-customization__title">{{ 'advanced-product-customization.storefront.title'|trans|default('Personalise your product') }}</h3>
            <span class="product-detail-customization__current-step" data-customization-progress aria-live="polite"></span>
        </div>

        <nav class="product-detail-customization__step-navigation" aria-label="{{ 'advanced-product-customization.storefront.title'|trans|default('Personalise your product') }}">
            <ol class="product-detail-customization__step-list">
                {% for step in steps %}
                    <li class="product-detail-customization__step-item">
                        <button
                            class="product-detail-customization__step-trigger"
                            data-customization-step-trigger
                            data-step-id="{{ step.id }}"
                            data-step-index="{{ loop.index0 }}"
                            type="button"
                        >
                            <span class="product-detail-customization__step-badge" aria-hidden="true">{{ loop.index }}</span>
                            <span class="product-detail-customization__step-label">{{ step.title }}</span>
                        </button>
                    </li>
                {% endfor %}
            </ol>
        </nav>

        <input type="hidden" name="lineItems[0][payload][advancedProductCustomization]" value="" data-customization-input />

        {% for step in steps %}
            <div
                class="product-detail-customization__step"
                data-customization-step
                data-step-id="{{ step.id }}"
                data-step-index="{{ loop.index0 }}"
                data-step-title="{{ step.title }}"
            >
                <div class="product-detail-customization__step-header">
                    <span class="product-detail-customization__step-badge" aria-hidden="true">{{ loop.index }}</span>
                    <div class="product-detail-customization__step-header-text">
                        <h4 class="product-detail-customization__step-title">{{ step.title }}</h4>
                        {% if step.description %}
                            <p class="product-detail-customization__step-description">{{ step.description }}</p>
                        {% endif %}
                    </div>
                </div>

                <div class="product-detail-customization__options">
                    {% for option in step.options %}
                        <div class="product-detail-customization__option">
                            <div class="product-detail-customization__option-content">
                                <strong class="product-detail-customization__option-title">{{ option.label }}</strong>
                                {% if option.description %}
                                    <p class="product-detail-customization__option-description">{{ option.description }}</p>
                                {% endif %}
                            </div>
                            <div class="product-detail-customization__option-actions">
                                {% if option.price %}
                                    <span class="product-detail-customization__price">+ {{ option.price|number_format(2, '.', ' ') }} {{ context.currency.symbol }}</span>
                                {% endif %}
                                <button
                                    class="btn btn-sm btn-outline-primary product-detail-customization__option-button"
                                    data-customization-option='{{ option|json_encode }}'
                                    data-step-id="{{ step.id }}"
                                    type="button"
                                >
                                    {{ 'advanced-product-customization.storefront.select'|trans|default('Select') }}
                                </button>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="product-detail-customization__actions">
                    {% if not loop.first %}
                        <button class="btn btn-light" data-customization-previous type="button">{{ 'advanced-product-customization.storefront.previous'|trans|default('Previous') }}</button>
                    {% endif %}
                    {% if not loop.last %}
                        <button class="btn btn-primary" data-customization-next type="button">{{ 'advanced-product-customization.storefront.next'|trans|default('Next') }}</button>
                    {% else %}
                        <button class="btn btn-primary" data-customization-next type="button">{{ 'advanced-product-customization.storefront.finish'|trans|default('Finish configuration') }}</button>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
